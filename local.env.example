# Box-specific settings for `make` (read by docker/run.sh). Copy to local.env,
# which is gitignored, and edit. One KEY=value per line.

# Datasets: $DATA_DIR/sf<SF>/parquet, format variants in $DATA_DIR/fmt_sf<SF>/,
# TQP-Vortex .pth files in $DATA_DIR/pth/. Needs ~0.4 TB per SF1000.
DATA_DIR=/data/haotiang/parquet-ablation

# Engine scratch (Spark local dirs, Polars spill, probe scratch) and the
# container's HOME. Keep it off a small root disk.
SCRATCH=/data/haotiang/scratch

# Ramdisk root the datasets are staged to before a run (SF500 is ~180 GB).
SHM=/dev/shm

# The one GPU (host index) the GPU engines use. GPUs are shared: pick an idle,
# non-exclusive one (`make doctor` checks).
GPU=7
